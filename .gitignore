# ==============================================================================
# LogSense .gitignore
# ==============================================================================

# Python Bytecode & Cache
__pycache__/
*.py[cod]
*$py.class
*.pyo

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Secrets
.env
.env.*
!.env.example

# Testing & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
nosetests.xml
coverage.xml
*.cover

# Distribution / Packaging
build/
dist/
*.egg-info/
.eggs/

# IDE & Editor Configurations
.vscode/
.idea/
*.swp
*.swo
*~

# Operating System Files
.DS_Store
Thumbs.db
desktop.ini

# Scratchpad & Temporary Logs
scratch/
*.tmp
*.temp

# Ignore general development logs, BUT ALWAYS ALLOW test datasets
*.log
!test_data/*.log
